{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-wiki.local/schemas/quiz-pack.schema.json",
  "title": "QuizPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "topic", "primarySource", "secondaryResults", "quiz", "sourceMode"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string"
    },
    "sessionKey": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "internal", "restricted", "private"]
    },
    "sourceMode": {
      "type": "string",
      "enum": ["local-db", "local-token", "local-public-redacted", "groq", "hybrid"]
    },
    "matchedBy": {
      "type": "string",
      "enum": ["db", "token", "none"]
    },
    "matchedCount": {
      "type": "integer",
      "minimum": 0
    },
    "primarySource": {
      "$ref": "#/$defs/pageRef"
    },
    "secondaryResults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pageRef"
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quizItem"
      }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "pageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "topic", "section", "visibility", "excerpt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "topic": { "type": "string" },
        "section": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "internal", "restricted", "private"] },
        "excerpt": { "type": "string" }
      }
    },
    "quizItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["short_answer", "multiple_choice", "compare", "scenario", "pitfall"]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "answerHint": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}