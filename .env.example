# Chọn 1 trong 2 cách cấu hình:
# 1. DATABASE_URL đầy đủ
# 2. Bộ POSTGRES_* bên dưới

# DATABASE_URL=postgresql://wiki_user:change_me@127.0.0.1:5432/ai_coding_wiki

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_coding_wiki
POSTGRES_USER=wiki_user
POSTGRES_PASSWORD=change_me

# Schema dùng cho bảng của AI Coding Wiki
WIKI_DB_SCHEMA=public

# Auth production / nội bộ
# Định dạng JSON. Mỗi role map tới password hoặc token tương ứng.
# Ví dụ: {"viewer":"viewer123","editor":"editor123","admin":"admin123"}
WIKI_AUTH_ROLES={"viewer":"viewer123","editor":"editor123","admin":"admin123"}
# Role mặc định khi không đăng nhập
WIKI_PUBLIC_ROLE=viewer
