DATABASE_URL=
WIKI_DB_SCHEMA=public

# Admin connection for init/migration only
ADMIN_DATABASE_URL=
ADMIN_WIKI_DB_SCHEMA=public

# Supabase storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=wiki-uploads

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Auth / session
WIKI_AUTH_ROLES={"viewer":"CHANGE_ME_VIEWER","editor":"CHANGE_ME_EDITOR","admin":"CHANGE_ME_ADMIN"}
WIKI_PUBLIC_ROLE=viewer
WIKI_JWT_SECRET=
WIKI_SESSION_TTL_SECONDS=86400

# Optional CORS for frontend on Vercel
WIKI_CORS_ORIGIN=*
